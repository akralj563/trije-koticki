---
// Ena predloga za vseh pet storitev energijskega kotička (podatki v src/data/vsebina.ts).
import Osnova from '../../layouts/Osnova.astro';
import Glava from '../../components/Glava.astro';
import PodstranUvod from '../../components/PodstranUvod.astro';
import PozivEposta from '../../components/PozivEposta.astro';
import Zakljucek from '../../components/Zakljucek.astro';
import { energija, mailto, storitev as poisci, urlStoritve, znamka, type Storitev } from '../../data/vsebina';

export function getStaticPaths() {
  return energija.storitve.map((s) => ({ params: { slug: s.slug }, props: { storitev: s } }));
}

interface Props {
  storitev: Storitev;
}
const { storitev } = Astro.props;
const sorodne = storitev.povezave.map(poisci);
---

<Osnova naslov={`${storitev.ime} — ${storitev.oznaka} | ${znamka.ime}`} opis={`${storitev.oznaka}. ${storitev.kratko}`}>
  <Glava />
  <main id="vsebina">
    <PodstranUvod
      drobtine={[
        { href: '/', oznaka: 'Domov' },
        { href: '/energijski-koticek/', oznaka: 'Energijski kotiček' },
        { oznaka: storitev.ime },
      ]}
      nadnaslov={storitev.oznaka}
      naslov={storitev.ime}
      uvod={storitev.uvod}
      slika={storitev.slika}
    >
      <a class="gumb pod-gumb" href={mailto(storitev.poziv.zadeva)} data-uvod>Pišite mi</a>
    </PodstranUvod>

    <div class="ovoj storitev">
      <aside class="storitev__stranica" data-razkrij="levo">
        <h2>Komu je namenjena</h2>
        <p>{storitev.komu}</p>
        <a class="povezava" href={mailto(storitev.poziv.zadeva)}>Vprašajte po e-pošti</a>
      </aside>

      <div class="storitev__odseki">
        {storitev.odseki.map((o) => (
          <section class="odsek" data-razkrij>
            <h2>{o.naslov}</h2>
            {o.odstavki?.map((p) => <p>{p}</p>)}
            {o.seznam && <ul class="odsek__seznam">{o.seznam.map((s) => <li>{s}</li>)}</ul>}
            {o.koraki && <ol class="odsek__koraki">{o.koraki.map((k) => <li>{k}</li>)}</ol>}
            {o.skupine && (
              <ul class="odsek__skupine">
                {o.skupine.map((g) => (
                  <li>
                    <h3>{g.naslov}</h3>
                    <p>{g.besedilo}</p>
                  </li>
                ))}
              </ul>
            )}
            {o.vec && (
              <details class="odsek__vec">
                <summary>Zakaj ravno k meni? <span>{o.vec.povzetek}</span></summary>
                <div class="odsek__vec-vsebina">{o.vec.odstavki.map((p) => <p>{p}</p>)}</div>
              </details>
            )}
            {o.povezave && (
              <p class="odsek__povezave">
                Preberite tudi:{' '}
                {o.povezave.map((slug, i) => (
                  <>
                    {i > 0 && ' in '}
                    <a href={urlStoritve(slug)}>{poisci(slug).ime}</a>
                  </>
                ))}
              </p>
            )}
          </section>
        ))}
        <p class="storitev__opomba">{energija.opomba}</p>
      </div>
    </div>

    <PozivEposta naslov={storitev.poziv.naslov} besedilo={storitev.poziv.besedilo} zadeva={storitev.poziv.zadeva} />

    <section class="sorodne" aria-labelledby="sorodne-naslov">
      <div class="ovoj">
        <h2 id="sorodne-naslov">Druge storitve</h2>
        <ul class="sorodne__seznam" data-stagger>
          {sorodne.map((s) => (
            <li>
              <a href={urlStoritve(s.slug)}>
                <span class="sorodne__oznaka">{s.oznaka}</span>
                <span class="sorodne__ime">{s.ime}</span>
                <span class="sorodne__kratko">{s.kratko}</span>
              </a>
            </li>
          ))}
        </ul>
        <a class="povezava" href="/energijski-koticek/">Vse storitve energijskega kotička</a>
      </div>
    </section>
  </main>
  <Zakljucek sKontaktom={false} />
</Osnova>

<script>
  import '../../scripts/gibanje';
</script>

<style>
  .pod-gumb {
    margin-top: 0.5rem;
    background: var(--podlaga);
    color: var(--gozd);
  }

  .pod-gumb:hover {
    background: var(--zarenje);
  }

  .storitev {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(3rem, 2rem + 4vw, 6rem);
  }

  .storitev__stranica {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    align-self: start;
    padding: 1.5rem;
    border-radius: 1.25rem;
    background: var(--zajbelj);
  }

  .storitev__stranica h2 {
    font-size: var(--fs-h3);
  }

  .storitev__stranica p {
    color: var(--besedilo-mehko);
  }

  .storitev__odseki {
    display: grid;
    gap: clamp(2.5rem, 2rem + 2vw, 4rem);
    max-width: 44rem;
  }

  .odsek {
    display: grid;
    gap: 1rem;
  }

  .odsek h2 {
    font-size: var(--fs-izjava);
    font-weight: 300;
  }

  .odsek p {
    color: var(--besedilo-mehko);
  }

  .odsek__seznam {
    display: grid;
    gap: 0.5rem;
  }

  .odsek__seznam li {
    position: relative;
    padding-left: 1.5rem;
  }

  .odsek__seznam li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.62em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--glina);
  }

  .odsek__koraki {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: korak;
  }

  .odsek__koraki li {
    counter-increment: korak;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.75rem;
    padding: 1rem 0;
    border-top: 1px solid var(--rob);
  }

  .odsek__koraki li::before {
    content: counter(korak, decimal-leading-zero);
    font-family: var(--pisava-naslovi);
    font-style: italic;
    font-size: var(--fs-uvod);
    color: var(--glina-temna);
  }

  .odsek__skupine {
    display: grid;
    gap: 0.75rem;
  }

  .odsek__skupine li {
    display: grid;
    gap: 0.5rem;
    padding: 1.25rem 1.4rem;
    border-radius: 1rem;
    background: var(--papir);
    box-shadow: inset 0 0 0 1px var(--rob);
  }

  .odsek__skupine h3 {
    font-size: var(--fs-uvod);
    font-weight: 400;
  }

  .odsek__vec {
    border-top: 1px solid var(--rob);
    border-bottom: 1px solid var(--rob);
  }

  .odsek__vec summary {
    display: grid;
    gap: 0.2rem;
    padding: 1rem 2rem 1rem 0;
    position: relative;
    cursor: pointer;
    list-style: none;
    font-weight: 500;
  }

  .odsek__vec summary::-webkit-details-marker {
    display: none;
  }

  .odsek__vec summary::after {
    content: '+';
    position: absolute;
    right: 0.25rem;
    top: 50%;
    translate: 0 -50%;
    font-size: 1.5rem;
    font-weight: 300;
    transition: rotate var(--hitro);
  }

  .odsek__vec[open] summary::after {
    rotate: 45deg;
  }

  .odsek__vec summary span {
    font-family: var(--pisava-naslovi);
    font-style: italic;
    font-weight: 400;
    font-size: var(--fs-uvod);
    color: var(--glina-temna);
  }

  .odsek__vec-vsebina {
    display: grid;
    gap: 1rem;
    padding-bottom: 1.25rem;
  }

  .odsek__povezave a {
    color: var(--glina-temna);
    font-weight: 500;
  }

  .storitev__opomba {
    padding-top: 1.5rem;
    border-top: 1px solid var(--rob);
    font-size: var(--fs-majhna);
    color: var(--besedilo-mehko);
  }

  .sorodne {
    padding-bottom: var(--prostor-sekcije);
  }

  .sorodne .ovoj {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .sorodne h2 {
    font-size: var(--fs-izjava);
    font-weight: 300;
  }

  .sorodne__seznam {
    width: 100%;
    display: grid;
    gap: 0.75rem;
  }

  .sorodne__seznam a {
    display: grid;
    gap: 0.35rem;
    height: 100%;
    padding: 1.4rem;
    border-radius: 1.25rem;
    background: var(--gozd-globok);
    color: var(--podlaga);
    text-decoration: none;
    transition: background-color var(--hitro), transform 0.14s var(--ease-out);
  }

  .sorodne__seznam a:hover {
    background: var(--gozd);
  }

  .sorodne__seznam a:active {
    transform: scale(0.98);
  }

  .sorodne__oznaka {
    font-size: var(--fs-drobna);
    color: var(--zarenje);
  }

  .sorodne__ime {
    font-family: var(--pisava-naslovi);
    font-size: var(--fs-h3);
    line-height: 1.1;
  }

  .sorodne__kratko {
    font-size: var(--fs-majhna);
    color: color-mix(in srgb, var(--podlaga) 78%, transparent);
  }

  .sorodne__seznam :focus-visible,
  .sorodne__seznam a:focus-visible {
    outline-color: var(--glina-temna);
  }

  @media (min-width: 40rem) {
    .sorodne__seznam {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }

    .odsek__skupine {
      grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    }
  }

  @media (min-width: 56rem) {
    .storitev {
      grid-template-columns: 4fr 8fr;
      column-gap: clamp(3rem, 1rem + 5vw, 7rem);
    }

    .storitev__stranica {
      position: sticky;
      top: calc(var(--glava-visina) + 1.5rem);
    }
  }
</style>
