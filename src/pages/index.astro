---
import Osnova from '../layouts/Osnova.astro';
import Glava from '../components/Glava.astro';
import ScrollVideoHero from '../components/ScrollVideoHero.astro';
import Delavnice from '../components/Delavnice.astro';
import ZnamkaPas from '../components/ZnamkaPas.astro';
import Zgodba from '../components/Zgodba.astro';
import Koticki from '../components/Koticki.astro';
import Nakit from '../components/Nakit.astro';
import Zelisca from '../components/Zelisca.astro';
import Snopi from '../components/Snopi.astro';
import Energija from '../components/Energija.astro';
import Zakljucek from '../components/Zakljucek.astro';
import { znamka } from '../data/vsebina';
---

<Osnova
  naslov={`${znamka.ime} — delavnice, nakit, zelišča in energijska podpora`}
  opis="Potovanje Življenja: ustvarjalne delavnice, unikatni nakit, sušena zelišča in snopi ter energijska podpora za odrasle in otroke."
>
  <Glava />
  <main id="vsebina">
    <ScrollVideoHero />
    <Delavnice />
    <ZnamkaPas />
    <Zgodba />
    <Koticki />
    <Nakit />
    <Zelisca />
    <Snopi />
    <Energija />
  </main>
  <Zakljucek />
</Osnova>

<script>
  import '../scripts/gibanje';
</script>
