---
// E-poštni poziv za podstrani (brez kontaktnega obrazca). Zadeva sporočila je izpolnjena vnaprej.
import Motiv from './Motiv.astro';
import { mailto, povezave } from '../data/vsebina';

interface Props {
  naslov: string;
  besedilo: string;
  zadeva: string;
  gumb?: string;
}
const { naslov, besedilo, zadeva, gumb = 'Pišite mi' } = Astro.props;
---

<section class="poziv" aria-labelledby="poziv-naslov">
  <div class="ovoj">
    <div class="poziv__plosca" data-razkrij>
      <Motiv vrsta="cvet" class="poziv__cvet" />
      <h2 id="poziv-naslov">{naslov}</h2>
      <p class="poziv__besedilo">{besedilo}</p>
      <div class="poziv__akcije">
        <a class="gumb" href={mailto(zadeva)}>{gumb}</a>
        <a class="poziv__eposta" href={mailto(zadeva)}>{povezave.eposta}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .poziv {
    padding-block: 0 var(--prostor-sekcije);
  }

  .poziv__plosca {
    position: relative;
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding: clamp(1.75rem, 1rem + 3vw, 4rem);
    border-radius: clamp(1.25rem, 0.9rem + 1vw, 2rem);
    background:
      radial-gradient(60% 80% at 100% 100%, color-mix(in srgb, var(--glina) 20%, transparent), transparent 70%),
      var(--pesek-svetel);
    overflow: hidden;
  }

  .poziv__plosca :global(.poziv__cvet) {
    position: absolute;
    top: 1.25rem;
    right: 1.5rem;
    width: clamp(3rem, 2rem + 3vw, 5.5rem);
    color: var(--oliva);
    opacity: 0.45;
  }

  .poziv h2 {
    max-width: 18ch;
    padding-right: 3rem;
    font-size: var(--fs-izjava);
    font-weight: 300;
  }

  .poziv__besedilo {
    max-width: 32rem;
    color: var(--besedilo-mehko);
  }

  .poziv__akcije {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 0.5rem;
  }

  .poziv__eposta {
    overflow-wrap: anywhere;
    font-size: var(--fs-majhna);
    color: var(--glina-temna);
  }
</style>
