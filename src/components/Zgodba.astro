---
import Motiv from './Motiv.astro';
import { zgodba } from '../data/vsebina';
---

<section id="zgodba" class="zgodba" aria-labelledby="zgodba-naslov">
  <div class="ovoj zgodba__mreza">
    <h2 id="zgodba-naslov" class="visually-hidden">Zgodba</h2>
    <p class="zgodba__poudarek" data-razkrij="levo">{zgodba.poudarek}</p>
    <div class="zgodba__stolpec" data-razkrij="desno">
      <Motiv vrsta="list" class="zgodba__list" />
      {zgodba.odstavki.map((o) => <p>{o}</p>)}
    </div>
    <blockquote class="zgodba__misel" data-razkrij>
      <p>{zgodba.misel}</p>
    </blockquote>
  </div>
</section>

<style>
  .zgodba {
    padding-block: var(--prostor-sekcije);
    background: var(--podlaga);
  }

  .zgodba__mreza {
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }

  .zgodba__poudarek {
    font-family: var(--pisava-naslovi);
    font-size: var(--fs-izjava);
    font-weight: 300;
    line-height: 1.14;
    letter-spacing: -0.02em;
    text-wrap: balance;
    max-width: 22ch;
  }

  .zgodba__poudarek::first-letter {
    float: left;
    margin: 0.06em 0.12em 0 0;
    font-size: 3.1em;
    line-height: 0.82;
    color: var(--glina);
    font-style: italic;
  }

  .zgodba__stolpec {
    position: relative;
    display: grid;
    gap: 1rem;
    max-width: 28rem;
    color: var(--besedilo-mehko);
    font-size: var(--fs-uvod);
  }

  .zgodba__stolpec :global(.zgodba__list) {
    width: 2.75rem;
    color: var(--oliva);
  }

  .zgodba__misel {
    margin: 0;
    padding-left: 1.5rem;
    border-left: 1px solid var(--glina);
    max-width: 26rem;
    font-family: var(--pisava-naslovi);
    font-style: italic;
    font-size: var(--fs-h3);
    line-height: 1.25;
    color: var(--oliva-temna);
  }

  @media (min-width: 56rem) {
    .zgodba__mreza {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }

    .zgodba__poudarek {
      grid-column: 1 / span 8;
    }

    .zgodba__stolpec {
      grid-column: 9 / span 4;
      padding-top: 1rem;
    }

    .zgodba__misel {
      grid-column: 6 / span 6;
      margin-top: 2rem;
    }
  }
</style>
