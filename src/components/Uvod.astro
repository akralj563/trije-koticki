---
import { Image } from 'astro:assets';
import Motiv from './Motiv.astro';
import { uvod, slike, snopi } from '../data/vsebina';

const sivka = snopi.izdelki[0].slika;
---

<section id="vrh" class="uvod" aria-labelledby="uvod-naslov">
  <div class="uvod__sij" aria-hidden="true"></div>
  <div class="ovoj uvod__mreza">
    <div class="uvod__besedilo">
      <p class="nadnaslov uvod__pozdrav" data-uvod>{uvod.pozdrav}</p>
      <h1 id="uvod-naslov" class="uvod__naslov">
        {uvod.naslov.map((v) => (
          <span class="uvod__vrstica"><span data-uvod-vrstica>{v}</span></span>
        ))}
      </h1>
      <p class="uvod__povzetek" data-uvod>{uvod.besedilo}</p>
      <div class="uvod__pozivi" data-uvod>
        <a class="gumb" href={uvod.pozivi[0].href}>{uvod.pozivi[0].oznaka}</a>
        <a class="gumb gumb--obroba" href={uvod.pozivi[1].href}>{uvod.pozivi[1].oznaka}</a>
      </div>
    </div>

    <div class="uvod__vizual">
      <Motiv vrsta="vejica" class="uvod__vejica" />
      <Motiv vrsta="cvet" class="uvod__cvet" />
      <figure class="uvod__lok" data-nagib>
        <div class="okvir uvod__okvir" data-uvod-slika>
          <Image
            src={slike.kosara.src}
            alt={slike.kosara.alt}
            widths={[476]}
            sizes="(min-width: 56rem) 34vw, 88vw"
            loading="eager"
            fetchpriority="high"
            data-hero-slika
          />
        </div>
        <figcaption class="znacka uvod__znacka">Začasni vizual</figcaption>
      </figure>
      <div class="okvir uvod__krog" data-uvod-krog>
        <Image src={sivka.src} alt="" widths={[360]} sizes="12rem" loading="eager" style={`object-position: ${sivka.pozicija}`} />
      </div>
    </div>
  </div>
  <a class="uvod__naprej" href="#zgodba">
    <span>Zgodba</span>
    <span class="uvod__naprej-crta" aria-hidden="true"></span>
  </a>
</section>

<style>
  .uvod {
    position: relative;
    min-height: min(100svh, 62rem);
    padding-top: calc(var(--glava-visina) + clamp(1.5rem, 1rem + 3vw, 4rem));
    padding-bottom: clamp(4rem, 3rem + 4vw, 7rem);
    display: grid;
    align-items: center;
    overflow: clip;
    background: var(--podlaga);
  }

  .uvod__sij {
    position: absolute;
    inset: -20% -10% auto auto;
    width: 70vw;
    aspect-ratio: 1;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--pesek) 85%, transparent), transparent);
    pointer-events: none;
  }

  .uvod__mreza {
    position: relative;
    width: 100%;
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 5rem);
    align-items: end;
  }

  .uvod__besedilo {
    display: grid;
    gap: clamp(1.25rem, 1rem + 1vw, 2rem);
    justify-items: start;
  }

  .uvod__naslov {
    font-size: var(--fs-h1);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.035em;
    font-variation-settings: 'opsz' 72;
  }

  .uvod__vrstica {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }

  .uvod__vrstica > span {
    display: inline-block;
  }

  .uvod__vrstica:nth-child(2) {
    padding-left: clamp(1.5rem, 0.5rem + 6vw, 7rem);
    font-style: italic;
    color: var(--oliva-temna);
  }

  .uvod__vrstica:nth-child(3) {
    padding-left: clamp(0.75rem, 0.25rem + 3vw, 3.5rem);
  }

  .uvod__povzetek {
    max-width: 31rem;
    font-size: var(--fs-uvod);
    color: var(--besedilo-mehko);
  }

  .uvod__pozivi {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Vizual: obokan izrez fotografije, krog s sivko in linijske vejice */
  .uvod__vizual {
    position: relative;
    justify-self: center;
    width: min(100%, 26rem);
  }

  .uvod__lok {
    position: relative;
    margin: 0;
    z-index: 1;
  }

  .uvod__okvir {
    aspect-ratio: 5 / 6.4;
    border-radius: 999px 999px 0.75rem 0.75rem;
    box-shadow: 0 40px 80px -40px color-mix(in srgb, var(--gozd) 55%, transparent);
  }

  .uvod__okvir img {
    object-position: 52% 55%;
    transform: scale(1.08);
  }

  .uvod__znacka {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
  }

  .uvod__krog {
    position: absolute;
    z-index: 2;
    left: -1.25rem;
    bottom: -2.5rem;
    width: clamp(6.5rem, 5rem + 6vw, 11rem);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 6px solid var(--podlaga);
  }

  .uvod__vizual :global(.uvod__vejica) {
    position: absolute;
    z-index: 0;
    width: 46%;
    left: -32%;
    top: -6%;
    color: var(--oliva);
    opacity: 0.75;
    transform: rotate(-14deg);
  }

  .uvod__vizual :global(.uvod__cvet) {
    position: absolute;
    z-index: 3;
    width: 30%;
    right: -12%;
    bottom: 8%;
    color: var(--glina);
    opacity: 0.9;
  }

  .uvod__naprej {
    position: absolute;
    left: var(--rob-strani);
    bottom: 1.5rem;
    display: none;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--fs-drobna);
    color: var(--besedilo-mehko);
    text-decoration: none;
  }

  .uvod__naprej-crta {
    width: 3rem;
    height: 1px;
    background: currentColor;
  }

  @media (min-width: 56rem) {
    .uvod__mreza {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
    }

    .uvod__vizual {
      justify-self: end;
      width: min(100%, 31rem);
      margin-right: clamp(0rem, 2vw, 2rem);
    }

    .uvod__naprej {
      display: inline-flex;
    }
  }

  @media (max-width: 55.99rem) {
    .uvod__vizual {
      width: min(84%, 22rem);
      margin-bottom: 1.5rem;
    }
  }

  /* Uvodni reveal: skrito le, dokler skript ne prevzame (varovalka v Osnova.astro). */
  :global(html.uvod-caka) [data-uvod],
  :global(html.uvod-caka) [data-uvod-vrstica],
  :global(html.uvod-caka) [data-uvod-slika],
  :global(html.uvod-caka) [data-uvod-krog] {
    opacity: 0;
  }
</style>
