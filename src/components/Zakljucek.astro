---
import Motiv from './Motiv.astro';
import { kontakt, mailto, navigacija, povezave, znamka } from '../data/vsebina';

interface Props {
  /** Na podstraneh je poziv že na strani, zato se izriše samo noga. */
  sKontaktom?: boolean;
}
const { sKontaktom = true } = Astro.props;
const leto = new Date().getFullYear();
---

{sKontaktom && (
<section id="kontakt" class="kontakt" data-ton="kontakt" aria-labelledby="kontakt-naslov">
  <div class="ovoj kontakt__mreza">
    <Motiv vrsta="cvet" class="kontakt__cvet" />
    <h2 id="kontakt-naslov" data-razkrij="levo">{kontakt.naslov}</h2>
    <div class="kontakt__besedilo" data-razkrij="desno">
      <p class="kontakt__misel">{kontakt.besedilo}</p>
      <p class="kontakt__status">{kontakt.poziv}</p>
      <a class="kontakt__eposta" href={mailto()}>{povezave.eposta}</a>
      {povezave.facebookUrl && (
        <a class="povezava kontakt__fb" href={povezave.facebookUrl} rel="noopener">Facebook: potovanje življenja</a>
      )}
    </div>
  </div>
</section>
)}

<footer class="noga" data-temno>
  <div class="ovoj">
    <div class="noga__vrh" data-razkrij>
      <p class="noga__znamka">
        <span>{znamka.ime}</span>
        <small>{znamka.opis}</small>
      </p>
      <nav aria-label="Noga">
        <ul>
          {navigacija.map((p) => <li><a href={p.href}>{p.oznaka}</a></li>)}
        </ul>
      </nav>
    </div>
    <div class="noga__dno">
      <p>© {leto} {znamka.ime}</p>
      <p class="noga__prototip">Lokalni prototip · fotografije so začasni vizuali</p>
      <a href={mailto()}>{povezave.eposta}</a>
      <a href="#">Na vrh</a>
    </div>
  </div>
</footer>

<style>
  /* Zaključni poziv: skoraj celozaslonska kompozicija */
  .kontakt {
    position: relative;
    min-height: 88vh;
    min-height: 88svh;
    display: grid;
    align-content: center;
    padding-block: var(--prostor-sekcije);
    background:
      radial-gradient(60% 80% at 100% 100%, color-mix(in srgb, var(--glina) 18%, transparent), transparent 70%),
      var(--podlaga);
    overflow: clip;
  }

  .kontakt__mreza {
    position: relative;
    width: 100%;
    display: grid;
    gap: 2.5rem;
  }

  .kontakt :global(.kontakt__cvet) {
    position: absolute;
    right: var(--rob-strani);
    top: calc(-1 * var(--prostor-sekcije) + 1.5rem);
    width: clamp(4rem, 3rem + 3vw, 6.5rem);
    color: var(--oliva);
    opacity: 0.5;
  }

  .kontakt h2 {
    font-size: var(--fs-h1);
    font-weight: 300;
    line-height: 0.98;
    letter-spacing: -0.035em;
    max-width: 11ch;
  }

  .kontakt__besedilo {
    display: grid;
    gap: 1.5rem;
    max-width: 30rem;
    align-content: end;
  }

  .kontakt__misel {
    font-family: var(--pisava-naslovi);
    font-style: italic;
    font-size: var(--fs-h3);
    line-height: 1.25;
    color: var(--oliva-temna);
  }

  .kontakt__status {
    font-size: var(--fs-majhna);
    color: var(--besedilo-mehko);
  }

  /* E-pošta je glavni poziv: velika, a se na ozkih zaslonih lahko prelomi. */
  .kontakt__eposta {
    justify-self: start;
    max-width: 100%;
    font-family: var(--pisava-naslovi);
    font-size: clamp(1.3rem, 1rem + 1.4vw, 2.1rem);
    line-height: 1.2;
    overflow-wrap: anywhere;
    color: var(--glina-temna);
    text-decoration-color: color-mix(in srgb, var(--glina-temna) 45%, transparent);
  }

  .kontakt__eposta:hover {
    text-decoration-color: currentColor;
  }

  @media (max-width: 39.99rem) {
    .kontakt {
      min-height: 0;
      padding-block: 4.5rem 3.5rem;
    }

    .kontakt__mreza {
      gap: 1.25rem;
    }

    .kontakt :global(.kontakt__cvet) {
      top: -3rem;
      width: 3.25rem;
    }

    .kontakt__besedilo {
      gap: 0.9rem;
    }

    .kontakt__misel {
      font-size: 1.2rem;
    }
  }

  @media (min-width: 56rem) {
    .kontakt__mreza {
      grid-template-columns: 7fr 5fr;
      align-items: end;
    }
  }

  .noga {
    padding-block: clamp(3rem, 2rem + 3vw, 5rem) 2rem;
    background: var(--gozd);
    color: var(--podlaga);
    font-size: var(--fs-majhna);
  }

  .noga__vrh {
    display: grid;
    gap: 2.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid color-mix(in srgb, var(--podlaga) 18%, transparent);
  }

  .noga__znamka {
    display: grid;
    gap: 0.5rem;
  }

  .noga__znamka span {
    font-family: var(--pisava-naslovi);
    font-weight: 300;
    font-size: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .noga__znamka small {
    font-size: var(--fs-majhna);
    color: color-mix(in srgb, var(--podlaga) 72%, transparent);
  }

  .noga ul {
    display: grid;
    gap: 0.6rem;
  }

  .noga a {
    color: inherit;
    text-decoration-color: color-mix(in srgb, var(--podlaga) 40%, transparent);
  }

  .noga a:hover {
    text-decoration-color: currentColor;
  }

  .noga :focus-visible {
    outline-color: var(--zarenje);
  }

  .noga__dno {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    justify-content: space-between;
    padding-top: 1.5rem;
    font-size: var(--fs-drobna);
    color: color-mix(in srgb, var(--podlaga) 75%, transparent);
  }

  .noga__prototip {
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--podlaga) 30%, transparent);
  }

  @media (max-width: 55.99rem) {
    .noga__vrh {
      gap: 1.75rem;
      padding-bottom: 2rem;
    }

    .noga ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.6rem 1rem;
    }
  }

  @media (min-width: 56rem) {
    .noga__vrh {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    .noga ul {
      grid-template-columns: repeat(2, auto);
      gap: 0.6rem 3rem;
    }
  }
</style>
